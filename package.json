{
  "name": "danogo-clmm",
  "version": "0.0.1",
  "description": "An SDK to calculate and execute swaps on the Danogo liquidity platform.",
  "main": "./dist/sdk.js",
  "module": "./dist/sdk.mjs",
  "types": "./dist/sdk.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cardano",
    "danogo",
    "swap",
    "clmm"
  ],
  "scripts": {
    "start": "tsc && node dist/main.js",
    "build": "tsup src/sdk.ts --format cjs,esm --dts --minify --clean --no-splitting",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lucid-evolution/lucid": "0.4.29",
    "axios": "^1.13.2",
    "cbor": "^10.0.11"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@lucid-evolution/lucid": "0.4.29"
  }
}
